{
  "FlowProtection": {
    "Enabled": false,
    "DefaultTtlSeconds": 300,
    "LockTtlSeconds": 30,
    "CompletedTtlSeconds": 60,
    "TicketHeaderName": "X-Flow-Ticket",
    "BusinessIdHeaderName": "X-Business-Id",
    "Flows": [
      {
        "FlowId": "user-role-abc",
        "TtlSeconds": 300,
        "Interfaces": [
          { "Name": "user", "Method": "POST", "Path": "/api/user1" },
          { "Name": "role", "Method": "POST", "Path": "/api/role1" },
          { "Name": "abc", "Method": "POST", "Path": "/api/abc1" }
        ],
        "Variants": { "default": ["user", "role", "abc"] }
      },
      {
        "FlowId": "order-pay-list",
        "TtlSeconds": 300,
        "Interfaces": [
          { "Name": "order", "Method": "POST", "Path": "/api/order1" },
          { "Name": "pay", "Method": "POST", "Path": "/api/pay1" },
          { "Name": "list", "Method": "GET", "Path": "/api/list2" }
        ],
        "Variants": { "default": ["order", "pay", "list"] }
      }
    ]
  },
  "ModuleConfigurations": {
    "CacheConfig": {
      "DistributedCacheConfig": {
        "Enabled": true,
        "ConnectionRef": ["gateway-redis"],
        "InstanceName": "girvs-gateway"
      }
    }
  },
  "Resources": {
    "gateway-redis": {
      "Type": "redis",
      "Settings": {
        "Endpoints": "redis:6379"
      }
    }
  }
}
