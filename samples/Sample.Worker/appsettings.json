{
  "CommonConfig": {
    "DisplayFullErrorStack": false
  },
  "HostingConfig": {
    "UseHttpClusterHttps": false,
    "UseHttpXForwardedProto": false,
    "ForwardedHttpHeader": ""
  },
  "ModuleConfigurations": {
    "CacheConfig": {
      "EnableCaching": true,
      "DefaultCacheTime": 60,
      "DistributedCacheConfig": {
        "Enabled": true,
        "ConnectionRef": ["sample-redis"],
        "SchemaName": "dbo",
        "TableName": "DistributedCache",
        "InstanceName": "sample-worker",
        "PublishIntervalMs": 500
      }
    }
  }
}
