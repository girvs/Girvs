<Project>
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <Version>10.0.0-rc.4.0.3</Version>
    <PackageVersion>10.0.0-rc.4.0.3</PackageVersion>
    <LangVersion>latest</LangVersion>
    <Copyright>kicck</Copyright>
    <PackageProjectUrl>https://github.com/girvs/Girvs</PackageProjectUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/girvs/Girvs</RepositoryUrl>
    <RepositoryType>Github</RepositoryType>
  </PropertyGroup>
</Project>
